# Invoice API — Umgebungsvariablen. Kopie als .env anlegen, Werte eintragen.
# Die .env bleibt lokal (.gitignore). Keine Werte in Git, Tickets oder Chat.

# PostgreSQL
DB_HOST=db.example.internal
DB_PORT=5432
DB_NAME=invoice
DB_USER=invoice_api
DB_PASSWORD=
DB_SSLMODE=disable
DB_SCHEMA=invoice

# Erster Start gegen eine leere Datenbank: true, danach wieder false.
RUN_SQL_MIGRATIONS=false

TZ=Europe/Berlin

# Nur für docker-compose.yml: wo der Port veröffentlicht wird.
INVOICE_BIND=127.0.0.1
INVOICE_API_PORT=8010
